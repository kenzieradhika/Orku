{
  "version": 1,
  "max_body_bytes": 65536,
  "limits": {
    "title_bytes": 200,
    "body_bytes": 2000,
    "client_key_bytes": 64,
    "list_limit_max": 100
  },
  "seed_rows": 200,
  "envelope": {
    "database": "items",
    "fields": ["id", "title", "body", "version", "client_key"],
    "errors": {
      "400": "Bad Request",
      "404": "Not Found",
      "409": "Conflict",
      "415": "Unsupported Media Type",
      "422": "Unprocessable Content",
      "500": "Internal Server Error"
    }
  },
  "routes": [
    {"name": "list", "method": "GET", "path": "/api/items", "statuses": [200, 422]},
    {"name": "get", "method": "GET", "path": "/api/items/{id}", "statuses": [200, 404]},
    {"name": "create", "method": "POST", "path": "/api/items", "statuses": [201, 409, 422]},
    {"name": "replace", "method": "PUT", "path": "/api/items/{id}", "statuses": [200, 404, 409, 422]},
    {"name": "delete", "method": "DELETE", "path": "/api/items/{id}", "statuses": [204, 404, 409, 422]}
  ],
  "maintenance": {
    "reset": {"method": "POST", "path": "/api/bench/reset"},
    "state": {"method": "GET", "path": "/api/bench/state"}
  }
}
